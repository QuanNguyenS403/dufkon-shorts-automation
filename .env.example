# Copy this file to .env and fill in any optional free API keys you want to use.
# .env is already ignored in .gitignore so keys are never committed.

# 1. Google Gemini API (Free Tier at https://aistudio.google.com/apikey)
# Powers scripts/generate_job.py (viral hooks, scene scripts, Flow prompts, SEO tags)
GEMINI_API_KEY=

# 2. Pexels Free API (Free key at https://www.pexels.com/api/)
# Fetches vertical 9:16 HD stock B-roll videos and photos
PEXELS_API_KEY=

# 3. Pixabay Free API (Free key at https://pixabay.com/api/docs/)
# Fetches royalty-free stock clips, images, and background music
PIXABAY_API_KEY=

# Note: NASA Image & Video Library, Wikimedia Commons, Edge-TTS, FFmpeg SFX,
# and YouTube Data API v3 work with ZERO extra API keys above.
